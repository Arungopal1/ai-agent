# ---------------------------------------------------------------------------
# 1. Pick ONE LLM provider (the free ones need no credit card)
# ---------------------------------------------------------------------------
# groq | openrouter | gemini | openai | ollama   (leave empty to auto-detect)
LLM_PROVIDER=groq

# Groq free tier: https://console.groq.com/keys
# Free models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter free models: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxx

# Google AI Studio free tier: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza-xxxx

# Local models (no key, runs on your machine): https://ollama.com
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Override the model for the selected provider (optional)
# LLM_MODEL=openai/gpt-oss-20b
# LLM_TEMPERATURE=0.3

# ---------------------------------------------------------------------------
# 2. Embeddings for document search (RAG)
# ---------------------------------------------------------------------------
# gemini  -> Google gemini-embedding-001 (free tier, needs GEMINI_API_KEY)
# hashing -> zero-dependency local fallback, demo quality only
# EMBEDDING_BACKEND=gemini
# EMBEDDING_MODEL=gemini-embedding-001

# ---------------------------------------------------------------------------
# 3. Optional extras
# ---------------------------------------------------------------------------
# Tavily gives much better web search than DuckDuckGo (free: 1000/mo)
# TAVILY_API_KEY=tvly-xxxx

# Lock the API: clients must send X-API-Key: <value>
# AGENT_API_KEY=

# Allowed browser origins for /api/* (comma separated, * = any)
# ALLOWED_ORIGINS=*

# Best-effort per-IP rate limit for /api/* requests per minute (0 = off)
# RATE_LIMIT_PER_MIN=30

# Agent + server knobs
# AGENT_MAX_STEPS=5
# MAX_UPLOAD_MB=4
# MAX_HISTORY_MESSAGES=20
